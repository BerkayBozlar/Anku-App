@model AnkuApp.Web.Services.ContentSyncDto
@using AnkuApp.Web.Services
<div class="card bg-body-tertiary mb-4">
    <div class="card-body small">
        <span>Günlük resmî kaynak kontrolü.</span>
        @if (Model?.LastAttemptAt is { } attempt)
        {
            <span>Son deneme: @PortalTime.ToLocal(attempt).ToString("dd.MM.yyyy HH:mm").</span>
        }
        @if (Model?.LastSuccessAt is { } success)
        {
            <span>Son başarılı kontrol: @PortalTime.ToLocal(success).ToString("dd.MM.yyyy HH:mm").</span>
        }
        else { <span>Henüz başarılı bir kaynak kontrolü yok.</span> }
        @if (Model?.LastError is { } error)
        {
            <div class="text-danger mt-2" role="alert">@error</div>
        }
    </div>
</div>
