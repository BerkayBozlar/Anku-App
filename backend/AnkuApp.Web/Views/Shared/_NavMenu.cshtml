@using AnkuApp.Web.Auth
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string ActiveIf(string name) => controller == name ? "active" : string.Empty;
}

@* Menü role göre değişir. "Yakında" olanlar 3. haftadan itibaren eklenecek. *@
<ul class="navbar-nav me-auto mb-2 mb-xl-0">
    <li class="nav-item">
        <a class="nav-link @ActiveIf("Home")" asp-controller="Home" asp-action="Index">Panel</a>
    </li>

    @if (User.IsInRole(Roles.Yonetici))
    {
        <li class="nav-item"><span class="nav-link disabled">Kulüpler <span class="badge text-bg-secondary">yakında</span></span></li>
        <li class="nav-item"><span class="nav-link disabled">Etkinlikler <span class="badge text-bg-secondary">yakında</span></span></li>
        <li class="nav-item"><span class="nav-link disabled">Duyurular <span class="badge text-bg-secondary">yakında</span></span></li>
        <li class="nav-item"><span class="nav-link disabled">Kullanıcılar <span class="badge text-bg-secondary">yakında</span></span></li>
    }
    else if (User.IsInRole(Roles.KulupYetkilisi))
    {
        <li class="nav-item"><span class="nav-link disabled">Kulübüm <span class="badge text-bg-secondary">yakında</span></span></li>
        <li class="nav-item"><span class="nav-link disabled">Etkinliklerim <span class="badge text-bg-secondary">yakında</span></span></li>
    }
</ul>
