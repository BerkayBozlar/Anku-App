@model EventListViewModel
@{
    ViewData["Title"] = Model.CanListAllClubs ? "Etkinlikler" : "Etkinliklerim";
    var result = Model.Page;
    // Varsayılan sekme (yaklaşan) adreste görünmesin
    var pastRoute = Model.Past ? "true" : null;
    // İşlem sayfaları bu listeye (sekme, arama, kulüp, sayfa) geri döner
    var here = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    @if (Model.Clubs.Count > 0)
    {
        <a class="btn btn-anku" asp-action="Create" asp-route-clubId="@Model.ClubId" asp-route-returnUrl="@here">Etkinlik ekle</a>
    }
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Past ? "" : "active")" aria-current="@(Model.Past ? null : "page")"
           asp-action="Index" asp-route-search="@Model.Search" asp-route-clubId="@Model.ClubId">Yaklaşan</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Past ? "active" : "")" aria-current="@(Model.Past ? "page" : null)"
           asp-action="Index" asp-route-past="true" asp-route-search="@Model.Search" asp-route-clubId="@Model.ClubId">Geçmiş</a>
    </li>
</ul>

@if (Model.Clubs.Count > 0)
{
    <form method="get" asp-action="Index" class="row g-2 mb-3" role="search">
        @if (Model.Past)
        {
            <input type="hidden" name="past" value="true" />
        }
        <div class="col-12 col-md-5">
            <label for="search" class="visually-hidden">Ara</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Başlıkta ara" />
        </div>
        @if (Model.Clubs.Count > 1 || Model.CanListAllClubs)
        {
            <div class="col-12 col-md-4">
                <label for="clubId" class="visually-hidden">Kulüp</label>
                <select id="clubId" name="clubId" class="form-select">
                    @if (Model.CanListAllClubs)
                    {
                        <option value="">Tüm kulüpler</option>
                    }
                    @foreach (var club in Model.Clubs)
                    {
                        <option value="@club.Id" selected="@(club.Id == Model.ClubId)">@club.Name</option>
                    }
                </select>
            </div>
        }
        else
        {
            <input type="hidden" name="clubId" value="@Model.ClubId" />
        }
        <div class="col-12 col-md-3 d-grid d-md-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Filtrele</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-past="@pastRoute" asp-route-clubId="@Model.ClubId">Temizle</a>
            }
        </div>
    </form>
}

@if (Model.LoadError is not null)
{
    <div class="alert alert-warning" role="alert">@Model.LoadError</div>
}
else if (result is null || result.Items.Count == 0)
{
    <div class="text-center text-muted border rounded py-5">
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <p class="mb-0">"@Model.Search" için etkinlik bulunamadı.</p>
        }
        else if (Model.Past)
        {
            <p class="mb-0">Tarihi geçmiş etkinlik yok.</p>
        }
        else if (Model.Clubs.Count == 0)
        {
            @* Kulüp yokken etkinlik formu kullanılamaz; yalnız yönetici buraya kulüpsüz düşer *@
            <p class="mb-2">Etkinlik eklemek için önce bir kulüp gerekir.</p>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Clubs" asp-action="Create">Önce bir kulüp ekleyin</a>
        }
        else
        {
            <p class="mb-2">Yaklaşan etkinlik yok.</p>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Create" asp-route-clubId="@Model.ClubId" asp-route-returnUrl="@here">Etkinlik ekle</a>
        }
    </div>
}
else
{
    @if (Model.Past)
    {
        <p class="small text-muted">Tarihi geçmiş etkinlikler düzenlenemez; ayrıntısı görüntülenebilir ve silinebilir.</p>
    }
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Etkinlik</th>
                    <th scope="col" class="d-none d-md-table-cell">Kulüp</th>
                    <th scope="col">Tarih</th>
                    <th scope="col" class="d-none d-lg-table-cell text-end">Kontenjan</th>
                    <th scope="col" class="d-none d-sm-table-cell">Durum</th>
                    <th scope="col" class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in result.Items)
                {
                    <tr class="@(Model.Past ? "text-body-secondary" : "")">
                        <td>
                            <a class="fw-semibold text-reset" asp-action="Details" asp-route-id="@e.Id" asp-route-returnUrl="@here">@e.Title</a>
                            <div class="small text-muted d-md-none">@e.ClubName</div>
                            <span class="badge @EventStatuses.BadgeClass(e.Status) d-sm-none">@EventStatuses.DisplayName(e.Status)</span>
                        </td>
                        <td class="d-none d-md-table-cell">@e.ClubName</td>
                        <td class="text-nowrap">@PortalTime.Format(e.EventDate)</td>
                        <td class="d-none d-lg-table-cell text-end">@(e.Capacity?.ToString() ?? "-")</td>
                        <td class="d-none d-sm-table-cell">
                            <span class="badge @EventStatuses.BadgeClass(e.Status)">@EventStatuses.DisplayName(e.Status)</span>
                        </td>
                        <td class="text-end text-nowrap">
                            @if (Model.Past)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@e.Id" asp-route-returnUrl="@here">Ayrıntı</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id" asp-route-returnUrl="@here">Düzenle</a>
                            }
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.Id" asp-route-returnUrl="@here">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (result.TotalPages > 1)
    {
        <nav aria-label="Sayfalar" class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span class="small text-muted">Toplam @result.TotalCount etkinlik, sayfa @result.Page / @result.TotalPages</span>
            <ul class="pagination mb-0">
                <li class="page-item @(result.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(result.Page - 1)" asp-route-past="@pastRoute" asp-route-search="@Model.Search" asp-route-clubId="@Model.ClubId">Önceki</a>
                </li>
                <li class="page-item @(result.Page >= result.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(result.Page + 1)" asp-route-past="@pastRoute" asp-route-search="@Model.Search" asp-route-clubId="@Model.ClubId">Sonraki</a>
                </li>
            </ul>
        </nav>
    }
}
