@model EventFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.IsNew ? "Etkinlik ekle" : "Etkinliği düzenle";
    var action = Model.IsNew ? "Create" : "Edit";
    var statusOptions = EventStatuses.All
        .Select(s => new SelectListItem(EventStatuses.DisplayName(s), s));
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="@action" asp-route-id="@Model.Id" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                    <input type="hidden" asp-for="CampusLocationId" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="ClubId" class="form-label"></label>
                            <select asp-for="ClubId" asp-items="Model.ClubOptions" class="form-select">
                                <option value="">Kulüp seçin</option>
                            </select>
                            <span asp-validation-for="ClubId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="statusOptions" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" maxlength="200" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <div class="form-text">Türkiye saati</div>
                            <span asp-validation-for="EventDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Capacity" class="form-label"></label>
                            <input asp-for="Capacity" class="form-control" min="1" />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-4">
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clubId="@Model.ClubId">Vazgeç</a>
                        <button type="submit" class="btn btn-anku">@(Model.IsNew ? "Ekle" : "Kaydet")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
