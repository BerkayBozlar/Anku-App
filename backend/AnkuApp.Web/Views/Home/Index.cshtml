@using System.Security.Claims
@using AnkuApp.Web.Auth
@{
    ViewData["Title"] = "Panel";
    var isAdmin = User.IsInRole(Roles.Yonetici);
    // (başlık, açıklama, controller, action); controller null ise "yakında"
    var cards = isAdmin
        ? new (string Title, string Description, string? Controller, string? Action)[]
        {
            ("Kulüpler", "Kulüpleri ve kulüp yetkililerini yönetin.", "Clubs", "Index"),
            ("Etkinlikler", "Tüm kulüplerin etkinliklerini ekleyin, düzenleyin, silin.", "Events", "Index"),
            ("Duyurular", "Resmî kaynağı yenileyin, duyuruları kontrol edin veya elle ekleyin.", "Announcements", "Index"),
            ("Yemekhane", "Ortak öğle menüsünü yenileyin veya elle düzenleyin.", "MealMenus", "Index"),
            ("Kullanıcılar", "Kullanıcıları ve rollerini görüntüleyin.", null, null)
        }
        : new (string Title, string Description, string? Controller, string? Action)[]
        {
            ("Kulübüm", "Kulübünüzün bilgilerini ve sosyal bağlantılarını güncelleyin.", "Clubs", "Mine"),
            ("Etkinliklerim", "Kulübünüzün etkinliklerini ekleyin, düzenleyin, silin.", "Events", "Index")
        };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Hoş geldiniz, @User.Identity?.Name</h1>
        <p class="text-muted mb-0">@Roles.DisplayName(User.FindFirstValue(ClaimTypes.Role)) paneli</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
    @foreach (var card in cards)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 card-title d-flex justify-content-between align-items-center">
                        @if (card.Controller is null)
                        {
                            @card.Title
                            <span class="badge text-bg-secondary">yakında</span>
                        }
                        else
                        {
                            <a class="stretched-link text-decoration-none" asp-controller="@card.Controller" asp-action="@card.Action">@card.Title</a>
                        }
                    </h2>
                    <p class="card-text small text-muted mb-0">@card.Description</p>
                </div>
            </div>
        </div>
    }
</div>
