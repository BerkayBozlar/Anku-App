@using System.Security.Claims
@using AnkuApp.Web.Auth
@{
    ViewData["Title"] = "Panel";
    var isAdmin = User.IsInRole(Roles.Yonetici);
    var cards = isAdmin
        ? new[]
        {
            ("Kulüpler", "Kulüpleri ve kulüp yetkililerini yönetin."),
            ("Etkinlikler", "Tüm kulüplerin etkinliklerini ekleyin, düzenleyin, silin."),
            ("Duyurular", "Resmî kaynaktan gelen duyuruları kontrol edin, elle duyuru ekleyin."),
            ("Kullanıcılar", "Kullanıcıları ve rollerini görüntüleyin.")
        }
        : new[]
        {
            ("Kulübüm", "Kulübünüzün bilgilerini ve sosyal bağlantılarını güncelleyin."),
            ("Etkinliklerim", "Kulübünüzün etkinliklerini ekleyin, düzenleyin, silin.")
        };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Hoş geldiniz, @User.Identity?.Name</h1>
        <p class="text-muted mb-0">@Roles.DisplayName(User.FindFirstValue(ClaimTypes.Role)) paneli</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
    @foreach (var (title, description) in cards)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 card-title d-flex justify-content-between align-items-center">
                        @title
                        <span class="badge text-bg-secondary">yakında</span>
                    </h2>
                    <p class="card-text small text-muted mb-0">@description</p>
                </div>
            </div>
        </div>
    }
</div>
