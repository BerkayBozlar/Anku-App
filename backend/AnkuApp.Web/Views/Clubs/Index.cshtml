@model ClubListViewModel
@{
    ViewData["Title"] = "Kulüpler";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
    <h1 class="h3 mb-0">Kulüpler</h1>
    <a class="btn btn-anku" asp-action="Create">Kulüp ekle</a>
</div>

@if (Model.LoadError is not null)
{
    <div class="alert alert-warning" role="alert">@Model.LoadError</div>
}
else if (Model.Clubs.Count == 0)
{
    <div class="text-center text-muted border rounded py-5">
        <p class="mb-2">Henüz kulüp eklenmemiş.</p>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Create">İlk kulübü ekle</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Kulüp</th>
                    <th scope="col" class="d-none d-md-table-cell">Yetkili</th>
                    <th scope="col" class="d-none d-lg-table-cell">Bağlantı</th>
                    <th scope="col" class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var club in Model.Clubs)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@club.Name</div>
                            @if (!string.IsNullOrEmpty(club.Description))
                            {
                                <div class="small text-muted text-truncate" style="max-width: 28rem;">@club.Description</div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell">
                            @if (club.AuthorizedUserName is null)
                            {
                                <span class="text-muted small">Atanmamış</span>
                            }
                            else
                            {
                                <div>@club.AuthorizedUserName</div>
                                <div class="small text-muted">@club.AuthorizedUserEmail</div>
                            }
                        </td>
                        <td class="d-none d-lg-table-cell small">
                            @if (!string.IsNullOrEmpty(club.SocialMediaUrl))
                            {
                                <a href="@club.SocialMediaUrl" target="_blank" rel="noopener noreferrer">@club.SocialMediaUrl</a>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Events" asp-action="Index" asp-route-clubId="@club.Id">Etkinlikler</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@club.Id">Düzenle</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@club.Id">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
