@model AnnouncementFormViewModel
@{ ViewData["Title"] = Model.Id is null ? "Duyuru ekle" : "Duyuruyu düzenle"; }
<div class="row justify-content-center"><div class="col-12 col-lg-8">
    <h1 class="h3 mb-3">@ViewData["Title"]</h1>
    <div class="card"><div class="card-body">
        <form asp-action="@(Model.Id is null ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
            <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" maxlength="300" /><span asp-validation-for="Title" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" class="form-control" rows="5" maxlength="4000"></textarea></div>
            <div class="mb-3"><label asp-for="SourceName" class="form-label"></label><input asp-for="SourceName" class="form-control" maxlength="150" /></div>
            <div class="mb-3"><label asp-for="SourceUrl" class="form-label"></label><input asp-for="SourceUrl" class="form-control" type="url" /><div class="form-text">ankara.edu.tr veya alt alanındaki resmî duyuru bağlantısını girin.</div><span asp-validation-for="SourceUrl" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="PublishedAt" class="form-label"></label><input asp-for="PublishedAt" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /></div>
            <button type="submit" class="btn btn-primary">Kaydet</button> <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
